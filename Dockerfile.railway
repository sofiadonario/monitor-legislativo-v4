# Railway Dockerfile for MackMonitor
FROM rocker/shiny:4.3.1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libgdal-dev \
    libudunits2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install R packages
RUN install2.r --error --skipinstalled \
    shiny \
    shinydashboard \
    DBI \
    RPostgres \
    dplyr \
    ggplot2 \
    plotly \
    leaflet \
    DT

# Set working directory
WORKDIR /app

# Copy essential files only
COPY RAILWAY_STARTUP_FIX.R ./
COPY app.R ./

# Test packages
RUN R -e "if(!require(shiny)) stop('shiny not installed'); cat('✓ Packages ready\n')"

# Expose port
EXPOSE 3838

# Start command
CMD ["R", "-e", "source('RAILWAY_STARTUP_FIX.R'); shiny::runApp(host='0.0.0.0', port=3838)"]