# Railway Dockerfile for MackMonitor - Enhanced Version
FROM rocker/shiny:4.3.1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libgdal-dev \
    libudunits2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install R packages with better error handling
RUN install2.r --error --skipinstalled \
    shiny \
    shinydashboard \
    DBI \
    RPostgres \
    dplyr \
    ggplot2 \
    plotly \
    leaflet \
    DT \
    stringr \
    scales \
    lubridate \
    tidyr \
    jsonlite \
    magrittr \
    sf \
    geobr \
    geojsonio \
    R.utils

# Set working directory
WORKDIR /app

# Copy essential files only
COPY RAILWAY_PRODUCTION_DB_FIX.R ./
COPY railway_db_connection_test.R ./
COPY app.R ./
COPY health_check.R ./
COPY simple_health.R ./

# Copy application modules, scripts, data, and fixes needed at runtime
COPY scripts/ ./scripts/
COPY modules/ ./modules/
COPY data/ ./data/
COPY fixes/ ./fixes/

# Verify all packages are properly installed
RUN R -e "required_packages <- c('shiny','shinydashboard','DBI','RPostgres','dplyr','DT','plotly'); for (pkg in required_packages) { if (!require(pkg, character.only = TRUE)) { stop(paste('Package', pkg, 'not installed properly')) } }; cat('All required packages verified\n')"

# Create healthcheck script that waits for app to be ready
RUN echo '#!/bin/bash\n\
# Wait for the port to be available\n\
for i in {1..30}; do\n\
  if curl -f -s http://localhost:$PORT/ >/dev/null 2>&1; then\n\
    echo "App is responding"\n\
    exit 0\n\
  fi\n\
  echo "Waiting for app... ($i/30)"\n\
  sleep 2\n\
done\n\
echo "Health check failed - app not responding"\n\
exit 1' > /app/healthcheck.sh && \
    chmod +x /app/healthcheck.sh

# Expose port
EXPOSE 3838

# Add healthcheck with longer timeout for Shiny startup
HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=3 \
  CMD /app/healthcheck.sh

# Enhanced start command with proper error handling
CMD ["R", "-e", "cat('🚀 Starting MackMonitor Railway App\\n'); options(shiny.port=as.numeric(Sys.getenv('PORT', 3838)), shiny.host='0.0.0.0'); shiny::runApp('app.R')"]