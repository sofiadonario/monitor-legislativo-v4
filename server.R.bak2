  # ANALYTICS TAB OUTPUTS - SAFE PLACEHOLDERS
  # ==========================================

  # Create safe placeholder for ALL analytics plotly charts
  analytics_placeholder <- function(title = "Analytics") {
    plot_ly() %>%
      add_annotations(
        text = paste0(title, " temporarily unavailable<br>Working on data optimization"),
        x = 0.5, y = 0.5,
        showarrow = FALSE,
        font = list(size = 14, color = "#6c757d"),
        xref = "paper", yref = "paper"
      ) %>%
      layout(
        xaxis = list(visible = FALSE, range = c(0, 1)),
        yaxis = list(visible = FALSE, range = c(0, 1)),
        margin = list(t = 50, b = 50, l = 50, r = 50)
      )
  }

  output$analytics_temporal_chart <- renderPlotly({
