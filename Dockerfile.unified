# Production Dockerfile for Monitor Legislativo v4 - Unified
FROM rocker/shiny:4.3.1

# Install ALL system dependencies including comprehensive spatial libraries
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    libsodium-dev \
    postgresql-client \
    redis-tools \
    curl \
    gdal-bin \
    libgeos++-dev \
    proj-data \
    proj-bin \
    libpng-dev \
    libjpeg-dev \
    libmagick++-dev \
    librsvg2-dev \
    libwebp-dev \
    libtiff5-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libfribidi-dev \
    libharfbuzz-dev \
    libv8-dev \
    && rm -rf /var/lib/apt/lists/*

# Force cache bust
ARG CACHE_BUST=10

# Install ALL R packages in a single consolidated command with proper error handling
RUN echo "Installing R packages at $(date)" && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          packages <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                       'DBI', 'RPostgres', 'pool', 'dbplyr', \
                       'config', 'httr', 'yaml', 'lubridate', \
                       'plotly', 'ggplot2', 'futile.logger', \
                       'openxlsx', 'readr', 'digest', 'shinyjs', 'shinycssloaders'); \
          for(pkg in packages) { \
            if(!require(pkg, character.only=TRUE, quietly=TRUE)) { \
              cat('Installing', pkg, '...\\n'); \
              install.packages(pkg, dependencies=TRUE, quiet=TRUE); \
            } \
          }" && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          # Install spatial packages required by leaflet \
          spatial_deps <- c('sp', 'sf', 'raster', 'png', 'base64enc', \
                           'htmltools', 'htmlwidgets', 'crosstalk', 'magrittr', \
                           'RColorBrewer', 'viridis', 'scales'); \
          for(pkg in spatial_deps) { \
            if(!require(pkg, character.only=TRUE, quietly=TRUE)) { \
              cat('Installing spatial dependency', pkg, '...\\n'); \
              install.packages(pkg, dependencies=TRUE, quiet=TRUE); \
            } \
          }" && \
    R -e "options(repos='https://cran.rstudio.com/', download.file.method='libcurl'); \
          # Install leaflet with retries \
          cat('Installing leaflet...\\n'); \
          success <- FALSE; \
          for(i in 1:5) { \
            tryCatch({ \
              install.packages('leaflet', dependencies=TRUE, quiet=FALSE); \
              library(leaflet); \
              success <- TRUE; \
              cat('✅ Leaflet installed successfully on attempt', i, '\\n'); \
              break; \
            }, error = function(e) { \
              cat('❌ Attempt', i, 'failed:', conditionMessage(e), '\\n'); \
              Sys.sleep(2); \
            }); \
          }; \
          if(!success) stop('Failed to install leaflet after 5 attempts')" && \
    R -e "cat('\\nInstalled packages:\\n'); print(installed.packages()[,c('Package', 'Version')])"

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p data/cache data/geographic www logs exports temp

# Copy application files
COPY app.R ./
COPY R/ ./R/
COPY config.yml ./

# Verify all packages
RUN R -e "required <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                       'DBI', 'RPostgres', 'pool', 'plotly', 'ggplot2', 'leaflet'); \
         installed <- installed.packages()[,'Package']; \
         missing <- required[!required %in% installed]; \
         if(length(missing) > 0) { \
           cat('ERROR: Missing packages:', missing, '\\n'); \
           quit(status=1); \
         } else { \
           cat('✅ All', length(required), 'required packages verified\\n'); \
         }"

# Test leaflet
RUN R -e "tryCatch({ \
           library(leaflet); \
           m <- leaflet(); \
           cat('✅ Leaflet test passed - map creation successful\\n'); \
         }, error = function(e) { \
           cat('❌ Leaflet test failed:', conditionMessage(e), '\\n'); \
           quit(status=1); \
         })"

# Set environment variables
ENV R_CONFIG_ACTIVE=production
ENV SHINY_LOG_LEVEL=INFO

# Expose port
EXPOSE ${PORT:-3838}

# Start the application
CMD ["R", "-e", "source('app.R')"]