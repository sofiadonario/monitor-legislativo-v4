# Production Dockerfile for Monitor Legislativo v4 - Unified
FROM rocker/shiny:4.3.1

# Install ALL system dependencies including comprehensive spatial libraries
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    libsodium-dev \
    postgresql-client \
    redis-tools \
    curl \
    gdal-bin \
    libgeos++-dev \
    libgeos-c1v5 \
    proj-data \
    proj-bin \
    libpng-dev \
    libjpeg-dev \
    libmagick++-dev \
    librsvg2-dev \
    libwebp-dev \
    libtiff5-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libfribidi-dev \
    libharfbuzz-dev \
    libv8-dev \
    # Additional dependencies for terra and s2 compilation
    g++ \
    gcc \
    libc6-dev \
    make \
    libglpk-dev \
    libgmp3-dev \
    libicu-dev \
    libnetcdf-dev \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Force cache bust
ARG CACHE_BUST=11

# Install core R packages
RUN echo "Installing core R packages at $(date)" && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          packages <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                       'DBI', 'RPostgres', 'pool', 'dbplyr', \
                       'config', 'httr', 'yaml', 'lubridate', \
                       'plotly', 'ggplot2', 'futile.logger', \
                       'htmltools', 'htmlwidgets', 'crosstalk', 'magrittr', \
                       'openxlsx', 'readr', 'digest', 'shinyjs', 'shinycssloaders'); \
          for(pkg in packages) { \
            if(!require(pkg, character.only=TRUE, quietly=TRUE)) { \
              cat('Installing', pkg, '...\\n'); \
              install.packages(pkg, dependencies=TRUE, quiet=TRUE); \
            } \
          }"

# Install spatial packages separately with proper order
RUN echo "Installing spatial dependencies..." && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          # Base spatial packages \
          install.packages('sp', dependencies=TRUE); \
          install.packages('units', dependencies=TRUE); \
          install.packages('classInt', dependencies=TRUE); \
          install.packages('png', dependencies=TRUE); \
          install.packages('base64enc', dependencies=TRUE)"

RUN echo "Installing s2 and sf..." && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          install.packages('s2', dependencies=TRUE); \
          install.packages('sf', dependencies=TRUE)"

RUN echo "Installing terra and raster..." && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          install.packages('terra', dependencies=TRUE); \
          install.packages('raster', dependencies=TRUE)"

RUN echo "Installing visualization packages..." && \
    R -e "options(repos='https://cran.rstudio.com/'); \
          install.packages(c('RColorBrewer', 'viridis', 'scales'), dependencies=TRUE)"

# Install leaflet with multiple retry methods
RUN echo "Installing leaflet package..." && \
    R -e "success <- FALSE; \
          repos <- c('https://cran.rstudio.com/', \
                     'https://cloud.r-project.org/', \
                     'https://cran.microsoft.com/snapshot/2023-10-01/'); \
          for(repo in repos) { \
            for(i in 1:2) { \
              tryCatch({ \
                options(repos=repo, download.file.method='libcurl'); \
                cat('Trying repo:', repo, 'attempt', i, '\\n'); \
                install.packages('leaflet', dependencies=TRUE); \
                library(leaflet); \
                leaflet(); \
                success <- TRUE; \
                cat('✅ Leaflet installed successfully from', repo, '\\n'); \
                break; \
              }, error = function(e) { \
                cat('❌ Failed with:', conditionMessage(e), '\\n'); \
              }); \
              if(success) break; \
            }; \
            if(success) break; \
          }; \
          if(!success) stop('Failed to install leaflet from all repositories')" && \
    R -e "cat('\\nInstalled packages:\\n'); print(installed.packages()[,c('Package', 'Version')])"

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p data/cache data/geographic www logs exports temp

# Copy application files
COPY app.R ./
COPY R/ ./R/
COPY config.yml ./

# Verify all packages
RUN R -e "required <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                       'DBI', 'RPostgres', 'pool', 'plotly', 'ggplot2', 'leaflet'); \
         installed <- installed.packages()[,'Package']; \
         missing <- required[!required %in% installed]; \
         if(length(missing) > 0) { \
           cat('ERROR: Missing packages:', missing, '\\n'); \
           cat('Installed packages:', sort(installed), '\\n'); \
           quit(status=1); \
         } else { \
           cat('✅ All', length(required), 'required packages verified\\n'); \
         }"

# Test leaflet functionality
RUN R -e "tryCatch({ \
           library(leaflet); \
           m <- leaflet(); \
           cat('✅ Leaflet test passed - map creation successful\\n'); \
         }, error = function(e) { \
           cat('❌ Leaflet test failed:', conditionMessage(e), '\\n'); \
           quit(status=1); \
         })"

# Set environment variables
ENV R_CONFIG_ACTIVE=production
ENV SHINY_LOG_LEVEL=INFO

# Expose port
EXPOSE ${PORT:-3838}

# Start the application
CMD ["R", "-e", "source('app.R')"]