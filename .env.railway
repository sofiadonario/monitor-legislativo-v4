# Railway Environment Variables Template - SECURITY NOTICE
# ========================================================
# 
# CRITICAL: This file contains environment variable TEMPLATES only.
# DO NOT store actual production credentials in this file.
# 
# For production deployment:
# 1. Set these variables in Railway's environment variables interface
# 2. Use Railway's secret management for sensitive data
# 3. Never commit actual credentials to version control
#
# LGPD Compliance: Ensure all database connections use encrypted connections
# and credentials are managed according to Brazilian data protection law.

# Database Configuration (set actual values in Railway environment)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://user:pass@postgres.railway.internal:5432/railway

# Redis Configuration (if needed)
REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379

# Application Configuration
PORT=3838
R_CONFIG_ACTIVE=production
SHINY_LOG_LEVEL=INFO
RAILWAY_ENVIRONMENT=production

# Security Configuration
USE_DATABASE_FIRST=true
ENABLE_DEBUG_LOGGING=false
ENABLE_SECURITY_LOGGING=true

# Rate Limiting Configuration
MAX_SEARCH_REQUESTS_PER_HOUR=100
MAX_EXPORT_REQUESTS_PER_HOUR=10

# LGPD Compliance Settings
DATA_RETENTION_DAYS=2555  # 7 years as per Brazilian law
ENABLE_AUDIT_LOGGING=true
ANONYMIZE_LOGS=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# Development/Testing only (remove in production)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=monitor_legislativo_dev
# PGUSER=postgres
# PGPASSWORD=dev_password_only