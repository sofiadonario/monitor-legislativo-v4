{
  "name": "monitor-legislativo-aws-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK Infrastructure for Monitor Legislativo v4 - Scalable Architecture for 500+ Users",
  "main": "lib/monitor-legislativo-stack.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
