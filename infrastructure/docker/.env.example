# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Brazilian Legislative Monitoring System - Local Development
# Copy this file to .env and configure your local environment
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
POSTGRES_DB=monitor_legislativo_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_change_me_in_production
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database URL (automatically constructed from above, or override)
DATABASE_URL=postgresql://postgres:dev_password_change_me_in_production@postgres:5432/monitor_legislativo_dev

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Redis Cache Settings  
REDIS_PASSWORD=dev_redis_password_change_me
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_URL=redis://:dev_redis_password_change_me@redis:6379

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Shiny Application Settings
SHINY_PORT=3838
SHINY_HOST=0.0.0.0
APP_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGS=true

# R Development Settings
R_SHINY_DEV_MODE=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session Security (generate random 32+ character strings)
SESSION_SECRET=dev_session_secret_change_me_to_random_32plus_chars
ENCRYPTION_KEY=dev_encryption_key_exactly_32chars

# =============================================================================
# OAUTH AUTHENTICATION (OPTIONAL)
# =============================================================================

# Google OAuth Configuration
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft OAuth Configuration  
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# =============================================================================
# LOCALIZATION AND TIMEZONE
# =============================================================================

# Brazilian Settings
TZ=America/Sao_Paulo
LC_ALL=pt_BR.UTF-8
LANG=pt_BR.UTF-8

# =============================================================================
# DEVELOPMENT AND BUILD SETTINGS
# =============================================================================

# Docker Build Arguments
BUILD_DATE=2024-01-01T00:00:00Z
VCS_REF=dev
VERSION=dev

# Development Tools
ENABLE_DEV_TOOLS=true

# =============================================================================
# MONITORING AND ALERTING (OPTIONAL)
# =============================================================================

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email Notifications
NOTIFICATION_EMAIL=admin@yourcompany.com

# =============================================================================
# PRODUCTION OVERRIDES
# For production deployment, override these values with secure alternatives:
#
# 1. Generate strong passwords:
#    POSTGRES_PASSWORD=$(openssl rand -base64 32)
#    REDIS_PASSWORD=$(openssl rand -base64 32)
#    SESSION_SECRET=$(openssl rand -base64 48)
#    ENCRYPTION_KEY=$(openssl rand -base64 32 | head -c 32)
#
# 2. Configure OAuth with real credentials from providers
# 3. Set APP_ENV=production
# 4. Set LOG_LEVEL=WARN or ERROR
# 5. Disable debug flags: ENABLE_DEBUG_LOGS=false, R_SHINY_DEV_MODE=false
# =============================================================================

# =============================================================================
# SECURITY NOTES:
# 
# - NEVER commit this file with real credentials to version control
# - Use Railway's environment variables in production
# - Rotate passwords and secrets regularly
# - Monitor access logs for suspicious activity
# - Enable HTTPS in production environments
# - Follow Brazilian LGPD compliance requirements for data handling
# =============================================================================