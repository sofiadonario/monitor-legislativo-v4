{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "R -e \"source('RAILWAY_STARTUP_FIX.R'); shiny::runApp(host='0.0.0.0', port=as.numeric(Sys.getenv('PORT', 3838)))\"",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}