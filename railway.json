{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "main_app/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "services": {
    "monitor-legislativo-api": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "main_app/Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100
      }
    },
    "rshiny-minimal": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile.rshiny-minimal"
      },
      "deploy": {
        "startCommand": "Rscript /app/run_app.R",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    }
  }
}