# Production Dockerfile for Monitor Legislativo v4 - Leaflet Fix
FROM rocker/shiny:4.3.1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    libsodium-dev \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set CRAN repo and install all packages using binary packages when available
RUN R -e "options(repos = c(CRAN = 'https://packagemanager.rstudio.com/all/latest')); \
    install.packages(c( \
        'shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
        'DBI', 'RPostgres', 'pool', 'config', 'httr', 'yaml', \
        'lubridate', 'plotly', 'ggplot2', 'futile.logger', \
        'htmltools', 'htmlwidgets', 'crosstalk', 'openxlsx', \
        'readr', 'digest', 'shinyjs', 'shinycssloaders' \
    ), type = 'binary')"

# Install leaflet separately using binary package
RUN R -e "options(repos = c(CRAN = 'https://packagemanager.rstudio.com/all/latest')); \
    install.packages('leaflet', type = 'binary'); \
    library(leaflet); \
    cat('Leaflet version:', as.character(packageVersion('leaflet')), '\n')"

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p data/cache data/geographic www logs exports temp

# Copy application files
COPY app.R ./
COPY R/ ./R/
COPY config.yml ./

# Verify installation
RUN R -e "pkgs <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                   'DBI', 'RPostgres', 'pool', 'plotly', 'ggplot2', 'leaflet'); \
         missing <- pkgs[!pkgs %in% installed.packages()[,'Package']]; \
         if(length(missing) > 0) { \
           stop('Missing packages: ', paste(missing, collapse=', ')) \
         } else { \
           cat('All required packages installed successfully\n'); \
           library(leaflet); \
           cat('Leaflet loaded successfully\n') \
         }"

# Set environment variables
ENV R_CONFIG_ACTIVE=production
ENV SHINY_LOG_LEVEL=INFO

# Expose port
EXPOSE ${PORT:-3838}

# Start the application
CMD ["R", "-e", "source('app.R')"]