# R Shiny Application - Git Ignore File

# R Environment
.RData
.Rhistory
.Rproj.user/
*.Rproj

# renv
renv/
renv/library/
renv/python/
renv/staging/

# Application data
data/cache/
data/temp/
logs/*.log
exports/*.csv
exports/*.xlsx
exports/*.pdf
exports/*.html
exports/*.json

# Environment and secrets
.env
.env.local
.env.production
.env.development
config.local.yml
secrets.yml

# Docker
.dockerignore

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-*

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Package development
*.tar.gz
*.zip

# Application specific
# Keep example files but ignore actual data
!data/README.md
!exports/README.md
!logs/README.md

# Database files (if using SQLite locally)
*.db
*.sqlite
*.sqlite3

# SSL certificates
ssl/
*.pem
*.key
*.crt

# Backup files
backup/
*.backup

# Testing
testthat/
test_results/

# Node modules (if any)
node_modules/

# Python (if any)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# OS generated files
.directory

# Application logs
shiny-server.log
app.log
error.log
access.log

# Performance profiling
Rprof.out
*.prof

# Memory dumps
*.mem

# Core dumps
core.*