# Production Environment Configuration Template
# Monitor Legislativo v4 - R Architecture
# Copy this file to .env.production and fill in your values

# Database Configuration
POSTGRES_DB=monitor_legislativo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# Application Configuration
APP_PORT=80
APP_SSL_PORT=443
LOG_LEVEL=INFO

# AI Service API Keys (optional - set these in your deployment environment)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Monitoring Configuration (optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=secure_grafana_password

# Security Configuration
JWT_SECRET=generate_a_random_jwt_secret
SESSION_SECRET=generate_a_random_session_secret

# Performance Configuration
R_MAX_MEMORY=2GB
SHINY_MAX_SESSIONS=100
CACHE_TTL=3600

# External API Configuration
LEXML_API_BASE_URL=https://www.lexml.gov.br/
GOVERNMENT_API_TIMEOUT=30

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# SSL Certificate paths (for custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Railway specific configurations (if deploying to Railway)
RAILWAY_ENVIRONMENT=production
NIXPACKS_BUILD_CMD="echo 'Production build'"

# Optional: Enable monitoring stack
ENABLE_MONITORING=false