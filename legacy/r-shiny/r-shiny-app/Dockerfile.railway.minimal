# Minimal Dockerfile for Railway R Shiny deployment
FROM rocker/shiny:4.3.1

# Install only essential system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy only essential files
COPY r-shiny-app/app-minimal.R .
COPY r-shiny-app/run_app_minimal.R .

# Install only shiny package (already in base image)
RUN R -e "if (!require('shiny')) install.packages('shiny', repos='https://cran.rstudio.com/')"

# Make run script executable
RUN chmod +x run_app_minimal.R

# Expose port
EXPOSE 3838

# Run app
CMD ["Rscript", "run_app_minimal.R"]