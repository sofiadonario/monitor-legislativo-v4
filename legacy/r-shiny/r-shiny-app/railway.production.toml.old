# Railway Production Configuration for Monitor Legislativo v4

[build]
dockerfile = "Dockerfile.production"

[deploy]
startCommand = "R -e \"options(shiny.port = as.integer(Sys.getenv('PORT', '3838')), shiny.host = '0.0.0.0', shiny.maxRequestSize = 100*1024^2); source('app.R')\""
healthcheckPath = "/health"
healthcheckTimeout = 300
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 3

[env]
PORT = "3838"
R_CONFIG_ACTIVE = "production"
SHINY_LOG_LEVEL = "INFO"
SHINY_LOG_FILE = "/app/logs/shiny.log"

# Database configuration (will be set via Railway database service)
# DATABASE_URL = "${{Postgres.DATABASE_URL}}"
# REDIS_URL = "${{Redis.REDIS_URL}}"

# Resource limits
[resources]
memory = "2GB"
cpu = "1000m"

# Health check configuration
[healthcheck]
path = "/health"
timeout = 30
interval = 60
retries = 3

# Scaling configuration
[scaling]
min = 1
max = 3
targetCPU = 70
targetMemory = 80

# Environment-specific settings
[environments.production]
replicas = 2

[environments.staging]
replicas = 1

# Custom headers for load balancing
[headers]
"X-Frame-Options" = "DENY"
"X-Content-Type-Options" = "nosniff"
"Referrer-Policy" = "strict-origin-when-cross-origin"