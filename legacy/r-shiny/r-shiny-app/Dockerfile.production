# Production Dockerfile for Monitor Legislativo v4 - BULLETPROOF LEAFLET
FROM rocker/shiny:4.3.1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# MEGA-BULLETPROOF LEAFLET INSTALLATION
# Strategy: Use RStudio Package Manager binary packages to avoid ALL compilation issues
ARG CACHE_BUST=10
RUN echo "BULLETPROOF LEAFLET INSTALLATION START" && \
    R -e "options(repos = c(CRAN = 'https://packagemanager.rstudio.com/all/latest'), timeout = 600); \
          pkgs <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', \
                   'leaflet', 'plotly', 'ggplot2', \
                   'RSQLite', 'DBI', 'RPostgres', 'pool', \
                   'config', 'httr', 'yaml', 'lubridate', \
                   'htmltools', 'htmlwidgets', 'crosstalk', \
                   'openxlsx', 'readr', 'digest', 'shinyjs', 'shinycssloaders'); \
          install.packages(pkgs, type = 'binary', dependencies = FALSE); \
          cat('PRIMARY INSTALLATION COMPLETE\\n')" && \
    R -e "if(!'leaflet' %in% installed.packages()[,'Package']) { \
            cat('FALLBACK: Installing leaflet from CRAN\\n'); \
            options(repos = 'https://cran.rstudio.com/'); \
            install.packages('leaflet', dependencies = TRUE) \
          }; \
          library(leaflet); \
          m <- leaflet(); \
          cat('✅ LEAFLET SUCCESSFULLY INSTALLED AND TESTED\\n'); \
          cat('Leaflet version:', as.character(packageVersion('leaflet')), '\\n')"

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p data/cache data/geographic www logs exports temp

# Copy application files
COPY app.R ./
COPY R/ ./R/
COPY www/ ./www/
COPY config.yml ./

# Final verification
RUN R -e "required <- c('shiny', 'shinydashboard', 'DT', 'dplyr', 'jsonlite', 'leaflet', 'plotly'); \
          missing <- required[!required %in% installed.packages()[,'Package']]; \
          if(length(missing) > 0) stop('MISSING: ', paste(missing, collapse=', ')); \
          cat('✅ ALL PACKAGES VERIFIED\\n')"

# Set environment variables
ENV R_CONFIG_ACTIVE=production
ENV SHINY_LOG_LEVEL=INFO

# Expose port
EXPOSE ${PORT:-3838}

# Start the application
CMD ["R", "-e", "options(shiny.port = as.integer(Sys.getenv('PORT', '3838')), shiny.host = '0.0.0.0', shiny.maxRequestSize = 100*1024^2); shiny::runApp('app.R', launch.browser = FALSE)"]