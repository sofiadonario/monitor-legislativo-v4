# Railway Frontend Environment Configuration
# This file is used when deploying the frontend to Railway

# Build environment
NODE_ENV=production
VITE_RAILWAY_ENVIRONMENT=true

# Backend connection (internal Railway networking)
BACKEND_URL=http://backend-api:8000

# Optional: If you want to use a specific backend URL
# VITE_API_URL=https://backend-api-production-2392.up.railway.app

# Public URL (will be set by Railway)
# PUBLIC_URL=https://your-frontend.up.railway.app