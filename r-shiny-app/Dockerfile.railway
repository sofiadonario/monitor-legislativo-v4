# Simplified Dockerfile for Railway deployment
FROM rocker/shiny:4.3.1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory to /app (where Railway expects it)
WORKDIR /app

# Copy app files
COPY . .

# Install R packages
RUN R -e "source('.Rprofile')"

# Create necessary directories
RUN mkdir -p data/cache data/geographic www logs exports

# Set permissions
RUN chown -R shiny:shiny /app

# Expose port
EXPOSE 3838

# Make run script executable
RUN chmod +x run_app.R

# Create a startup script that Railway's auto-detection will use
RUN echo '#!/usr/bin/env Rscript' > /app/startup.R && \
    echo 'message(">>>> CUSTOM STARTUP SCRIPT EXECUTING <<<<")' >> /app/startup.R && \
    echo 'source("/app/app.R")' >> /app/startup.R && \
    chmod +x /app/startup.R

# Run app (Railway may override this)
CMD ["Rscript", "run_app.R"]