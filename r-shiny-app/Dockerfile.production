# Production-ready Multi-stage Dockerfile for Monitor Legislativo v4
# Stage 1: Dependencies and package installation
FROM rocker/shiny:4.3.1 AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    libsodium-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy renv files for reproducible package management
COPY renv.lock ./
COPY .Rprofile ./

# Install renv and restore packages
RUN R -e "install.packages('renv', repos = 'https://cran.rstudio.com/')" && \
    R -e "renv::restore()"

# Stage 2: Production runtime
FROM rocker/shiny:4.3.1

# Install only runtime system dependencies
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libudunits2-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libpq-dev \
    libsodium-dev \
    postgresql-client \
    redis-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user for security
RUN useradd -m -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy R library from builder stage
COPY --from=builder /usr/local/lib/R/site-library /usr/local/lib/R/site-library
COPY --from=builder /build/renv /app/renv

# Copy application files
COPY app.R ./
COPY R/ ./R/
COPY www/ ./www/
COPY config.yml ./
COPY .Rprofile ./

# Copy health check script
COPY scripts/health_check.sh /usr/local/bin/health_check
RUN chmod +x /usr/local/bin/health_check

# Create necessary directories with proper permissions
RUN mkdir -p data/cache data/geographic www logs exports temp && \
    chown -R appuser:appuser /app

# Set environment variables for production
ENV R_CONFIG_ACTIVE=production
ENV SHINY_LOG_LEVEL=INFO
ENV SHINY_LOG_FILE=/app/logs/shiny.log

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/health_check || exit 1

# Switch to non-root user
USER appuser

# Expose port (using environment variable for flexibility)
EXPOSE ${PORT:-3838}

# Production startup with signal handling and memory limits
CMD ["R", "-e", "options(shiny.port = as.integer(Sys.getenv('PORT', '3838')), shiny.host = '0.0.0.0', shiny.maxRequestSize = 100*1024^2); source('app.R')"]