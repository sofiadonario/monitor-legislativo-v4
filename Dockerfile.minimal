# Minimal Dockerfile for Monitor Legislativo v4 - Railway Deployment
FROM rocker/r-base:4.3.1

# Install only the most essential package
RUN R -e "install.packages('shiny', repos='https://cloud.r-project.org/')"

WORKDIR /app

# Copy ONLY the two essential files
COPY app.R ./
COPY database.R ./

# List files to verify they were copied (diagnostic)
RUN ls -la

# Expose port and run
EXPOSE 3838
CMD ["R", "-e", "options(shiny.port = 3838, shiny.host = '0.0.0.0'); source('app.R')"]