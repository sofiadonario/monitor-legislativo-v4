{
  "permissions": {
    "allow": [
      "Bash(for:*)",
      "Bash(do mv \"$file\" .archive/docs_old/)",
      "Bash(do mv \"$file\" .archive/cloudbuild_old/)",
      "Bash(if [ -f \"download_geo_data.R\" ])",
      "Bash(then mv download_geo_data.R scripts/)",
      "Bash(if [ -d db ])",
      "Bash(then echo '=== Contents of db/ ===')",
      "Bash(else echo \"db/ directory does not exist\")",
      "Bash(then find db -maxdepth 1 -name \"*.sql\" -type f -exec sh -c 'mv \"\"$1\"\" database/analysis/ && echo \"\"Moved $(basename \"\"$1\"\") to database/analysis/\"\"' _ {} ;)",
      "Bash(if [ -d \"dev-tools\" ])",
      "Bash(then mv dev-tools .archive/)",
      "Bash(else echo \"dev-tools/ does not exist\")",
      "Bash(if [ -d \"implementation\" ])",
      "Bash(then mv implementation .archive/)",
      "Bash(else echo \"implementation/ does not exist\")",
      "Bash(git check-ignore:*)",
      "Bash(do if [ -f \"$file\" ])",
      "Bash(then mv \"$file\" .archive/old_backups/)",
      "Bash(if [ -f \"verify-final-state.sql\" ])",
      "Bash(then mv verify-final-state.sql database/analysis/)",
      "Bash(do if [ -d \"$dir\" ])",
      "Bash(then rm -rf \"$dir\")",
      "Bash(then mv \"$dir\" .archive/)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true
}
