# Environment Configuration for Monitor Legislativo v4
# Copy this file to .env and configure with your values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
R_CONFIG_ACTIVE=production

# Application Domain
DOMAIN=monitor-legislativo.com
APP_URL=https://monitor-legislativo.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=monitor_legislativo
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=your_secure_password_here

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DATABASE=0

# Cache Settings
CACHE_TTL_DEFAULT=3600
CACHE_MAX_MEMORY=512MB

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================

# OpenAI API
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# HuggingFace API (optional)
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT and Session Secrets
JWT_SECRET=your_jwt_secret_min_32_chars_here
SESSION_SECRET=your_session_secret_min_32_chars_here

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings for Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=noreply@monitor-legislativo.com

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana
GRAFANA_PASSWORD=your_grafana_admin_password

# Prometheus
PROMETHEUS_RETENTION=30d

# Alert Webhook (Slack, Discord, etc.)
ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# AWS S3 for Backups
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Backup Retention
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# EXTERNAL APIS CONFIGURATION
# =============================================================================

# Brazilian Government APIs
CAMARA_API_KEY=your_camara_api_key_if_needed
SENADO_API_KEY=your_senado_api_key_if_needed

# IBGE API (usually no key required)
IBGE_API_TIMEOUT=30

# LexML API (usually no key required)
LEXML_API_TIMEOUT=60

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Application Performance
WORKERS=4
MAX_REQUEST_SIZE=50MB
REQUEST_TIMEOUT=30
SESSION_TIMEOUT=1800

# Memory Limits
MEMORY_LIMIT=2GB
CACHE_MEMORY_LIMIT=512MB

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Log Format (json, text)
LOG_FORMAT=json

# Log Rotation
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate Paths (inside container)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=admin@monitor-legislativo.com
LETSENCRYPT_STAGING=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Debug Settings (only for development)
DEBUG_MODE=false
ENABLE_PROFILING=false
ENABLE_HOT_RELOAD=false

# Development Database (SQLite fallback)
DEV_SQLITE_PATH=/app/data/monitor_legislativo.db

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
ENABLE_AI_FEATURES=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_RECOMMENDATIONS=true
ENABLE_ANALYTICS=true
ENABLE_EXPORTS=true
ENABLE_USER_MANAGEMENT=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# API Rate Limits
API_RATE_LIMIT=100
API_RATE_WINDOW=900

# Search Rate Limits
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW=300

# AI Service Rate Limits
AI_RATE_LIMIT=30
AI_RATE_WINDOW=3600

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Image Tags
APP_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=15-alpine
REDIS_IMAGE_TAG=7-alpine
NGINX_IMAGE_TAG=alpine

# Container Resource Limits
APP_CPU_LIMIT=2
APP_MEMORY_LIMIT=4g

DB_CPU_LIMIT=1
DB_MEMORY_LIMIT=2g

REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512m

# =============================================================================
# NETWORKING CONFIGURATION
# =============================================================================

# Port Configuration
APP_PORT=3838
API_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Network Subnet
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Custom Settings (add your own as needed)
CUSTOM_TITLE=Monitor Legislativo v4
CUSTOM_SUBTITLE=Plataforma de Análise Legislativa
CUSTOM_LOGO_URL=/assets/logo.png

# Analytics Tracking
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
ENABLE_ANALYTICS_TRACKING=false

# Social Media Integration
TWITTER_HANDLE=@MonitorLegislativo
FACEBOOK_PAGE=MonitorLegislativoBR

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================

# 1. Change ALL default passwords and secrets
# 2. Use strong, unique passwords (minimum 16 characters)
# 3. Store this file securely and never commit to version control
# 4. Use environment-specific configurations for staging/production
# 5. Regularly rotate API keys and passwords
# 6. Enable 2FA for all external services
# 7. Use AWS IAM roles instead of access keys when possible
# 8. Implement secrets management (HashiCorp Vault, AWS Secrets Manager)

# =============================================================================
# ENVIRONMENT VALIDATION
# =============================================================================

# Required variables that must be set:
# - POSTGRES_PASSWORD
# - JWT_SECRET
# - SESSION_SECRET
# - GRAFANA_PASSWORD
# - At least one AI API key (OPENAI_API_KEY or ANTHROPIC_API_KEY)

# Optional but recommended:
# - SMTP configuration for email notifications
# - Backup configuration for data protection
# - Monitoring webhook for alerts